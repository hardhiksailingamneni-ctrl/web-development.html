<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>College Information & Admissions Website</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f4f4;
}

nav{
    background:#003366;
    padding:15px;
    text-align:center;
    position:sticky;
    top:0;
}

nav a{
    color:white;
    text-decoration:none;
    margin:10px;
    padding:8px 15px;
}

nav a:hover{
    background:orange;
    border-radius:5px;
}

.banner{
    background:linear-gradient(to right,#0052D4,#4364F7,#6FB1FC);
    color:white;
    text-align:center;
    padding:60px 20px;
}

.banner h1{
    font-size:40px;
}

.container{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    padding:20px;
}

.card{
    background:white;
    width:300px;
    margin:15px;
    padding:20px;
    border-radius:10px;
    box-shadow:0 0 10px gray;
    transition:0.3s;
}

.card:hover{
    transform:scale(1.05);
}

.card h2{
    color:#003366;
    margin-bottom:10px;
}

footer{
    background:#003366;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:20px;
}

@media(max-width:768px){
    nav a{
        display:block;
        margin:5px;
    }

    .card{
        width:90%;
    }
}
</style>
</head>

<body>

<nav>
    <a href="#about">About</a>
    <a href="#departments">Departments</a>
    <a href="#courses">Courses</a>
    <a href="#faculty">Faculty</a>
    <a href="#admissions">Admissions</a>
    <a href="#facilities">Facilities</a>
    <a href="#events">Events</a>
    <a href="#contact">Contact</a>
</nav>

<div class="banner">
    <h1>ABC College of Engineering</h1>
    <p>Excellence in Education and Innovation</p>
</div>

<div class="container">

    <div class="card" id="about">
        <h2>About College</h2>
        <p>ABC College provides quality education with modern infrastructure and experienced faculty.</p>
    </div>

    <div class="card" id="departments">
        <h2>Departments</h2>
        <p>Computer Science Engineering</p>
        <p>Electronics & Communication</p>
        <p>Mechanical Engineering</p>
        <p>Civil Engineering</p>
    </div>

    <div class="card" id="courses">
        <h2>Courses Offered</h2>
        <p>B.Tech</p>
        <p>M.Tech</p>
        <p>MBA</p>
        <p>MCA</p>
    </div>

    <div class="card" id="faculty">
        <h2>Faculty Profiles</h2>
        <p>Dr. Rajesh - Principal</p>
        <p>Prof. Kumar - CSE HOD</p>
        <p>Prof. Anitha - ECE HOD</p>
    </div>

    <div class="card" id="admissions">
        <h2>Admissions Procedure</h2>
        <p>1. Fill Online Application</p>
        <p>2. Submit Documents</p>
        <p>3. Attend Counseling</p>
        <p>4. Confirm Admission</p>
    </div>

    <div class="card" id="facilities">
        <h2>Campus Facilities</h2>
        <p>Library</p>
        <p>Computer Labs</p>
        <p>Sports Complex</p>
        <p>Hostel Facility</p>
    </div>

    <div class="card" id="events">
        <h2>College Events</h2>
        <p>Technical Fest</p>
        <p>Cultural Fest</p>
        <p>Sports Meet</p>
        <p>Workshops & Seminars</p>
    </div>

    <div class="card" id="contact">
        <h2>Contact Details</h2>
        <p>Email: info@abccollege.com</p>
        <p>Phone: +91 9876543210</p>
        <p>Address: Hyderabad, Telangana</p>
    </div>

</div>

<footer>
    <p>&copy; 2026 ABC College of Engineering. All Rights Reserved.</p>
</footer>

</body>
</html>